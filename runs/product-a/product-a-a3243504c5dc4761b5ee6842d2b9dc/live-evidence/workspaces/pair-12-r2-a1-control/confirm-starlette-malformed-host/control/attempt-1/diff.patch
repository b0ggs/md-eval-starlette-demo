+def parse_host_authority(host_header: str, *, validate_port: bool = False) -> HostAuthority | None:
+    """Parse a Host header into its host and optional decimal port."""
+    if host_header.startswith("["):
+        closing_bracket = host_header.find("]")
+        if closing_bracket == -1:
+            return None
+
+        host = host_header[: closing_bracket + 1]
+        remainder = host_header[closing_bracket + 1 :]
+        literal = host[1:-1]
+        try:
+            # Zone identifiers are not part of the IP-literal syntax used by Host.
+            if "%" in literal:
+                return None
+            ipaddress.IPv6Address(literal)
+        except ValueError:
+            if _IPV_FUTURE_RE.fullmatch(literal) is None:
+                return None
+    else:
+        host, separator, remainder = host_header.partition(":")
+        if separator:
+            remainder = ":" + remainder
+        if _REG_NAME_RE.fullmatch(host) is None:
+            return None
+
+    if not remainder:
+        port = None
+    elif remainder.startswith(":") and _PORT_RE.fullmatch(remainder[1:]) is not None:
+        port = remainder[1:]
+    else:
+        return None
+
+    if validate_port and port is not None:
+        significant_port = port.lstrip("0") or "0"
+        if len(significant_port) > 5 or (len(significant_port) == 5 and significant_port > "65535"):
+            return None
+
+    return HostAuthority(host, port)
