+@pytest.mark.anyio
+async def test_request_form_context_manager_closes_upload_files() -> None:
+    request = Request({"type": "http", "method": "POST", "headers": [], "query_string": b""})
+    upload = UploadFile(SpooledTemporaryFile(), filename="example.txt")
+    another_upload = UploadFile(SpooledTemporaryFile(), filename="another.txt")
+    request._form = FormData({"file": upload, "another": another_upload})
+
+    async with request.form() as form:
+        assert form["file"] is upload
+        assert not upload.file.closed
+
+    assert upload.file.closed
+    assert another_upload.file.closed
+
+
+@pytest.mark.anyio
+async def test_request_form_context_manager_closes_upload_files_on_error() -> None:
+    request = Request({"type": "http", "method": "POST", "headers": [], "query_string": b""})
+    upload = UploadFile(SpooledTemporaryFile(), filename="example.txt")
+    request._form = FormData({"file": upload})
+
+    with pytest.raises(RuntimeError, match="context failed"):
+        async with request.form():
+            raise RuntimeError("context failed")
+
+    assert upload.file.closed
+
+
