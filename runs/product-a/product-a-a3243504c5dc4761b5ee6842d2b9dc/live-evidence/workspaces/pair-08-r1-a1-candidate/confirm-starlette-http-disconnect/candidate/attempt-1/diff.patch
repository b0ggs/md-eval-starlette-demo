+@pytest.mark.anyio
+async def test_streaming_response_stops_if_sending_http_disconnect() -> None:
+    chunks_consumed = 0
+
+    async def receive() -> Message:
+        pytest.fail("receive should not be called for ASGI 2.4+")
+
+    async def send(message: Message) -> None:
+        if message["type"] == "http.response.body":
+            raise OSError
+
+    async def stream() -> AsyncIterator[bytes]:
+        nonlocal chunks_consumed
+        for _ in range(2):
+            chunks_consumed += 1
+            yield b"chunk"
+
+    response = StreamingResponse(content=stream())
+    scope = {"asgi": {"spec_version": "2.4"}}
+
+    with pytest.raises(ClientDisconnect):
+        await response(scope, receive, send)
+
