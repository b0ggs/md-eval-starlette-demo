+def test_https_redirect_validates_authority(test_client_factory: TestClientFactory) -> None:
+    app = Starlette(middleware=[Middleware(HTTPSRedirectMiddleware)])
+
+    client = test_client_factory(app, base_url="http://fallback.example:123")
+    response = client.get("/", headers={"host": "bad/host"}, follow_redirects=False)
+    assert response.headers["location"] == "https://fallback.example:123/"
+
+    client = test_client_factory(app, base_url="http://[2001:db8::1]:80")
+    response = client.get("/", headers={"host": "bad/host"}, follow_redirects=False)
+    assert response.headers["location"] == "https://[2001:db8::1]/"
+
+    response = client.get("/", headers={"host": "example.com:000443"}, follow_redirects=False)
+    assert response.headers["location"] == "https://example.com/"
+
+
+def test_https_redirect_without_authority(test_client_factory: TestClientFactory) -> None:
+    middleware = HTTPSRedirectMiddleware(Starlette())
+
+    async def app(scope: Scope, receive: Receive, send: Send) -> None:
+        scope = {**scope, "server": None, "headers": [(b"host", b"bad/host")]}
+        await middleware(scope, receive, send)
+
+    client = test_client_factory(app)
+    response = client.get("/", follow_redirects=False)
+    assert response.status_code == 400
+    assert response.text == "Invalid host header"
