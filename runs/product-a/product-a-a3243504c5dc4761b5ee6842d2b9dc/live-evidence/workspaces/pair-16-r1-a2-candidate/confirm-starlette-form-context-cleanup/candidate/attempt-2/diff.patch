+class AwaitableOrContextManagerWrapper(Generic[CloseableT]):
+    def __init__(self, awaitable: Awaitable[CloseableT]) -> None:
+        self.awaitable = awaitable
+
+    def __await__(self) -> Generator[Any, None, CloseableT]:
+        return self.awaitable.__await__()
+
+    async def __aenter__(self) -> CloseableT:
+        self.entered = await self.awaitable
+        return self.entered
+
+    async def __aexit__(self, *args: Any) -> None:
+        await self.entered.close()
