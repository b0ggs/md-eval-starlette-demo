+@pytest.mark.parametrize("raise_in_context", [False, True])
+def test_request_form_context_manager_closes_files(
+    raise_in_context: bool, test_client_factory: TestClientFactory
+) -> None:
+    uploads: list[UploadFile] = []
+
+    async def context_manager_app(scope: Scope, receive: Receive, send: Send) -> None:
+        request = Request(scope, receive)
+
+        try:
+            async with request.form() as form:
+                uploads.extend(value for _, value in form.multi_items() if isinstance(value, UploadFile))
+                assert all(not upload.file.closed for upload in uploads)
+                if raise_in_context:
+                    raise RuntimeError("context body failed")
+        except RuntimeError:
+            assert raise_in_context
+
+        response = JSONResponse({"files": len(uploads), "closed": all(upload.file.closed for upload in uploads)})
+        await response(scope, receive, send)
+
+    client = test_client_factory(context_manager_app)
+    response = client.post(
+        "/",
+        files=[("first", ("first.txt", b"first")), ("second", ("second.txt", b"second"))],
+    )
+
+    assert response.json() == {"files": 2, "closed": True}
+
