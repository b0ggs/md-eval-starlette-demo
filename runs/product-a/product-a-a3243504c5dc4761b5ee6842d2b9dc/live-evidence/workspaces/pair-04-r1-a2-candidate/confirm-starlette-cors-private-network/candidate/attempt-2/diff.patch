+def test_cors_private_network_preflight(
+    test_client_factory: TestClientFactory,
+) -> None:
+    def homepage(request: Request) -> None:
+        pass  # pragma: no cover
+
+    headers = {
+        "Origin": "https://example.org",
+        "Access-Control-Request-Method": "GET",
+        "Access-Control-Request-Private-Network": "true",
+    }
+
+    app = Starlette(
+        routes=[Route("/", endpoint=homepage)],
+        middleware=[Middleware(CORSMiddleware, allow_origins=["https://example.org"])],
+    )
+    response = test_client_factory(app).options("/", headers=headers)
+    assert response.status_code == 400
+    assert response.text == "Disallowed CORS private-network"
+    assert "access-control-allow-private-network" not in response.headers
+
+    app = Starlette(
+        routes=[Route("/", endpoint=homepage)],
+        middleware=[
+            Middleware(
+                CORSMiddleware,
+                allow_origins=["https://example.org"],
+                allow_private_network=True,
+            )
+        ],
+    )
+    response = test_client_factory(app).options("/", headers=headers)
+    assert response.status_code == 200
+    assert response.text == "OK"
+    assert response.headers["access-control-allow-private-network"] == "true"
+
+
