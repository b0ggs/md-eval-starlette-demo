diff --git a/tests/middleware/test_base.py b/tests/middleware/test_base.py
index 7232cfd..1aa4030 100644
--- a/tests/middleware/test_base.py
+++ b/tests/middleware/test_base.py
@@ -297,6 +297,31 @@ async def test_run_background_tasks_even_if_client_disconnects() -> None:
     assert background_task_run.is_set()
 
 
+@pytest.mark.anyio
+async def test_background_task_exception_is_propagated() -> None:
+    async def raise_runtime_error() -> None:
+        raise RuntimeError("Background task failed")
+
+    async def endpoint(scope: Scope, receive: Receive, send: Send) -> None:
+        response = Response(background=BackgroundTask(raise_runtime_error))
+        await response(scope, receive, send)
+
+    async def passthrough(request: Request, call_next: RequestResponseEndpoint) -> Response:
+        return await call_next(request)
+
+    app = BaseHTTPMiddleware(endpoint, dispatch=passthrough)
+    scope = {"type": "http", "method": "GET", "path": "/"}
+
+    async def receive() -> Message:
+        return {"type": "http.request", "body": b"", "more_body": False}
+
+    async def send(message: Message) -> None:
+        pass
+
+    with pytest.raises(RuntimeError, match="Background task failed"):
+        await app(scope, receive, send)
+
+
 @pytest.mark.anyio
 async def test_do_not_block_on_background_tasks() -> None:
     response_complete = anyio.Event()
