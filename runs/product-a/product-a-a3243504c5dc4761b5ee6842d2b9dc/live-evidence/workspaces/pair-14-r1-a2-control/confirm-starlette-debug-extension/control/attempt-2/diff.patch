+def test_testclient_http_response_debug(test_client_factory: TestClientFactory) -> None:
+    async def app(scope: Scope, receive: Receive, send: Send) -> None:
+        await send({"type": "http.response.debug", "info": {"custom": "value"}})
+        await send({"type": "http.response.start", "status": 200, "headers": []})
+        await send({"type": "http.response.body", "body": b"Hello, world!"})
+
+    client = test_client_factory(app)
+    response = client.get("/")
+    assert response.extensions["http.response.debug"] == {"custom": "value"}
+
+
+def test_testclient_http_response_debug_template_context(test_client_factory: TestClientFactory) -> None:
+    template = object()
+    context = {"request": object()}
+    info = {"template": template, "context": context, "custom": "value"}
+
+    async def app(scope: Scope, receive: Receive, send: Send) -> None:
+        await send({"type": "http.response.debug", "info": info})
+        await send({"type": "http.response.start", "status": 200, "headers": []})
+        await send({"type": "http.response.body", "body": b"Hello, world!"})
+
+    client = test_client_factory(app)
+    response = client.get("/")
+    assert response.template is template  # type: ignore[attr-defined]
+    assert response.context is context  # type: ignore[attr-defined]
+    assert response.extensions["http.response.debug"] == info
+
