 import io
+from collections.abc import Callable
 from tempfile import SpooledTemporaryFile
 from typing import BinaryIO
 
@@ -359,6 +360,28 @@ async def test_uploadfile_rolling(max_size: int) -> None:
     await file.close()
 
 
+@pytest.mark.anyio
+async def test_uploadfile_uses_threadpool_for_rollover(monkeypatch: pytest.MonkeyPatch) -> None:
+    stream: BinaryIO = SpooledTemporaryFile(max_size=4)  # type: ignore[assignment]
+    file = UploadFile(filename="file", file=stream, size=0)
+    threaded_writes: list[bytes] = []
+
+    async def mocked_run_in_threadpool(func: Callable[[bytes], int], data: bytes) -> int:
+        threaded_writes.append(data)
+        return func(data)
+
+    monkeypatch.setattr("starlette.datastructures.run_in_threadpool", mocked_run_in_threadpool)
+
+    await file.write(b"data")
+    assert threaded_writes == []
+    assert not stream._rolled  # type: ignore[attr-defined]
+
+    await file.write(b"!")
+    assert threaded_writes == [b"!"]
+    assert stream._rolled  # type: ignore[attr-defined]
+    stream.close()
+
+
