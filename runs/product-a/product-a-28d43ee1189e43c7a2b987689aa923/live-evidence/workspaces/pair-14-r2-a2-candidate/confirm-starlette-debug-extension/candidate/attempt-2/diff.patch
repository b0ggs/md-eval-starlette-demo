+def test_http_response_debug_extension(test_client_factory: TestClientFactory) -> None:
+    def get_response(info: dict[str, Any]) -> Any:
+        async def app(scope: Scope, receive: Receive, send: Send) -> None:
+            await send({"type": "http.response.debug", "info": info})
+            await send({"type": "http.response.start", "status": 200, "headers": []})
+            await send({"type": "http.response.body", "body": b"ok"})
+
+        return test_client_factory(app).get("/")
+
+    info = {"traceback": ["frame one", "frame two"], "details": {"request_id": 123}}
+    response = get_response(info)
+    assert response.extensions["http.response.debug"] == info
+
+    template = object()
+    context = {"request": object()}
+    info = {"template": template, "context": context, "details": {"request_id": 456}}
+    response = get_response(info)
+    assert response.extensions["http.response.debug"] == info
+    assert response.template is template
+    assert response.context is context
+
+
