+def test_request_form_context_manager_closes_all_files_on_error(
+    test_client_factory: TestClientFactory,
+) -> None:
+    async def context_app(scope: Scope, receive: Receive, send: Send) -> None:
+        request = Request(scope, receive)
+        awaited_form = await request.form()
+        uploads = [value for value in awaited_form.values() if isinstance(value, UploadFile)]
+        assert len(uploads) == 2
+        assert all(not upload.file.closed for upload in uploads)
+
+        with pytest.raises(RuntimeError, match="context body failed"):
+            async with request.form() as context_form:
+                assert context_form is awaited_form
+                raise RuntimeError("context body failed")
+
+        assert all(upload.file.closed for upload in uploads)
+        response = JSONResponse({"closed": len(uploads)})
+        await response(scope, receive, send)
+
+    client = test_client_factory(context_app)
+    response = client.post(
+        "/",
+        files={"first": ("first.txt", b"first"), "second": ("second.txt", b"second")},
+    )
+    assert response.json() == {"closed": 2}
+
