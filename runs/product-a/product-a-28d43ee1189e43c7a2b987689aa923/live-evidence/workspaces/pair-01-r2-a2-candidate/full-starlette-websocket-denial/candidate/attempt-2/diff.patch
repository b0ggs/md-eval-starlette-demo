+@pytest.mark.anyio
+async def test_send_denial_streaming_response() -> None:
+    messages: list[Message] = []
+    background_calls = 0
+
+    async def receive() -> Message:
+        await anyio.sleep_forever()
+
+    async def send(message: Message) -> None:
+        messages.append(message)
+
+    async def background() -> None:
+        nonlocal background_calls
+        background_calls += 1
+
+    scope: Scope = {
+        "type": "websocket",
+        "asgi": {"spec_version": "2.4"},
+        "headers": [],
+        "extensions": {"websocket.http.response": {}},
+    }
+    websocket = WebSocket(scope, receive=receive, send=send)
+    response = StreamingResponse(
+        iter([b"streamed ", b"denial"]), status_code=401, background=BackgroundTask(background)
+    )
+
+    await websocket.send_denial_response(response)
+
+    assert messages == [
+        {"type": "websocket.http.response.start", "status": 401, "headers": []},
+        {"type": "websocket.http.response.body", "body": b"streamed ", "more_body": True},
+        {"type": "websocket.http.response.body", "body": b"denial", "more_body": True},
+        {"type": "websocket.http.response.body", "body": b"", "more_body": False},
+    ]
+    assert background_calls == 1
+
+
+@pytest.mark.anyio
+async def test_send_denial_file_response(tmp_path: Path) -> None:
+    path = tmp_path / "denial.txt"
+    path.write_bytes(b"file denial")
+    messages: list[Message] = []
+
+    async def receive() -> Message:  # type: ignore[empty-body]
+        ...  # pragma: no cover
+
+    async def send(message: Message) -> None:
+        messages.append(message)
+
+    scope: Scope = {"type": "websocket", "headers": [], "extensions": {"websocket.http.response": {}}}
+    websocket = WebSocket(scope, receive=receive, send=send)
+
+    await websocket.send_denial_response(FileResponse(path, status_code=403))
+
+    assert messages[0]["type"] == "websocket.http.response.start"
+    assert messages[0]["status"] == 403
+    assert messages[1:] == [
+        {"type": "websocket.http.response.body", "body": b"file denial", "more_body": False}
+    ]
+
+
