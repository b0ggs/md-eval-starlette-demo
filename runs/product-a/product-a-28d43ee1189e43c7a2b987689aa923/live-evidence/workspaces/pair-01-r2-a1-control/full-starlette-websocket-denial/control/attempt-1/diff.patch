 from starlette.websockets import WebSocket, WebSocketDisconnect, WebSocketState
@@ -322,6 +324,95 @@ def test_send_denial_response(test_client_factory: TestClientFactory) -> None:
     assert exc.value.content == b"foo"
 
 
+@pytest.mark.anyio
+async def test_send_streaming_denial_response() -> None:
+    background_call_count = 0
+    sent_messages: list[Message] = []
+
+    async def background() -> None:
+        nonlocal background_call_count
+        background_call_count += 1
+
+    async def stream() -> AsyncIterator[str]:
+        yield "streamed"
+        yield " body"
+
+    async def receive() -> Message:
+        raise AssertionError("Streaming denial responses must not poll for HTTP disconnects")
+
+    async def send(message: Message) -> None:
+        sent_messages.append(message)
+
+    scope: Scope = {
+        "type": "websocket",
+        "headers": [],
+        "extensions": {"websocket.http.response": {}},
+    }
+    websocket = WebSocket(scope, receive=receive, send=send)
+    response = StreamingResponse(
+        stream(),
+        status_code=403,
+        background=BackgroundTask(background),
+    )
+    await websocket.send_denial_response(response)
+
+    assert sent_messages == [
+        {"type": "websocket.http.response.start", "status": 403, "headers": []},
+        {"type": "websocket.http.response.body", "body": b"streamed", "more_body": True},
+        {"type": "websocket.http.response.body", "body": b" body", "more_body": True},
+        {"type": "websocket.http.response.body", "body": b"", "more_body": False},
+    ]
+    assert background_call_count == 1
+
+
+@pytest.mark.anyio
+async def test_send_file_denial_response(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    path = tmp_path / "denial.txt"
+    content = b"file denial body"
+    path.write_bytes(content)
+    sent_messages: list[Message] = []
+
+    class AsyncFile:
+        position = 0
+
+        async def __aenter__(self) -> "AsyncFile":
+            return self
+
+        async def __aexit__(self, *args: Any) -> None:
+            pass
+
+        async def read(self, size: int) -> bytes:
+            chunk = content[self.position : self.position + size]
+            self.position += len(chunk)
+            return chunk
+
+    async def open_file(*args: Any, **kwargs: Any) -> AsyncFile:
+        return AsyncFile()
+
+    monkeypatch.setattr(anyio, "open_file", open_file)
+
+    async def receive() -> Message:
+        raise AssertionError("File denial responses must not receive")
+
+    async def send(message: Message) -> None:
+        sent_messages.append(message)
+
+    scope: Scope = {
+        "type": "websocket",
+        "headers": [],
+        "extensions": {"websocket.http.response": {}, "http.response.pathsend": {}},
+    }
+    websocket = WebSocket(scope, receive=receive, send=send)
+    response = FileResponse(path, status_code=401, stat_result=path.stat())
+    response.chunk_size = 4
+    await websocket.send_denial_response(response)
+
+    assert sent_messages[0]["type"] == "websocket.http.response.start"
+    assert sent_messages[0]["status"] == 401
+    assert all(message["type"] == "websocket.http.response.body" for message in sent_messages[1:])
+    assert b"".join(message["body"] for message in sent_messages[1:]) == b"file denial body"
+
+
 def test_send_response_multi(test_client_factory: TestClientFactory) -> None:
     async def app(scope: Scope, receive: Receive, send: Send) -> None:
         websocket = WebSocket(scope, receive=receive, send=send)
