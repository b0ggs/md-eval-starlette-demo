+@pytest.mark.anyio
+async def test_request_form_is_awaitable_context_manager_and_closes_uploads() -> None:
+    request = Request({"type": "http"})
+    request._form = FormData({"field": "value"})
+    assert await request.form() is request._form
+
+    for exception in (None, RuntimeError("context failed")):
+        uploads = [UploadFile(BytesIO(b"first")), UploadFile(BytesIO(b"second"))]
+        request._form = FormData([("files", upload) for upload in uploads])
+        expectation = nullcontext() if exception is None else pytest.raises(RuntimeError, match="context failed")
+
+        with expectation:
+            async with request.form() as form:
+                assert form is request._form
+                assert all(not upload.file.closed for upload in uploads)
+                if exception is not None:
+                    raise exception
+
+        assert all(upload.file.closed for upload in uploads)
+
