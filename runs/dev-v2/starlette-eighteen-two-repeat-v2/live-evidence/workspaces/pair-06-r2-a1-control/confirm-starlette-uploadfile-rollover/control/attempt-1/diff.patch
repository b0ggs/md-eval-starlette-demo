 import io
+from collections.abc import Callable
 from tempfile import SpooledTemporaryFile
 from typing import BinaryIO
 
 import pytest
 
+import starlette.datastructures
 from starlette.datastructures import (
     URL,
     CommaSeparatedStrings,
@@ -359,6 +361,28 @@ async def test_uploadfile_rolling(max_size: int) -> None:
     await file.close()
 
 
+@pytest.mark.anyio
+async def test_uploadfile_write_uses_threadpool_for_rollover(monkeypatch: pytest.MonkeyPatch) -> None:
+    stream: BinaryIO = SpooledTemporaryFile(max_size=4)  # type: ignore[assignment]
+    file = UploadFile(filename="file", file=stream, size=0)
+    writes_in_threadpool = 0
+
+    async def run_in_threadpool(func: Callable[..., object], *args: object) -> object:
+        nonlocal writes_in_threadpool
+        writes_in_threadpool += 1
+        return func(*args)
+
+    monkeypatch.setattr(starlette.datastructures, "run_in_threadpool", run_in_threadpool)
+
+    await file.write(b"data")
+    assert writes_in_threadpool == 0
+
+    await file.write(b"more")
+    assert writes_in_threadpool == 1
+    assert not file._in_memory
+    await file.close()
+
+
