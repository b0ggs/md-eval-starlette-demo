+def test_file_response_oversized_suffix_range(file_response_client: TestClient) -> None:
+    file_content = README.encode("utf8")
+    response = file_response_client.get("/", headers={"Range": f"bytes=-{len(file_content) + 1}"})
+
+    assert response.status_code == 206
+    assert response.headers["content-range"] == f"bytes 0-{len(file_content) - 1}/{len(file_content)}"
+    assert response.headers["content-length"] == str(len(file_content))
+    assert response.content == file_content
+
+
