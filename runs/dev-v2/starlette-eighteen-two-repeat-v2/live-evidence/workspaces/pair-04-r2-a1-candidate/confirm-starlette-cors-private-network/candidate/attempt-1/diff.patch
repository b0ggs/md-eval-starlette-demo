--- a/tests/middleware/test_cors.py
+++ b/tests/middleware/test_cors.py
@@ -168,6 +168,28 @@ def test_cors_allow_specific_origin(
     assert "access-control-allow-origin" not in response.headers
 
 
+def test_cors_private_network_preflight(
+    test_client_factory: TestClientFactory,
+) -> None:
+    headers = {
+        "Origin": "https://example.org",
+        "Access-Control-Request-Method": "GET",
+        "Access-Control-Request-Private-Network": "true",
+    }
+
+    app = Starlette(
+        middleware=[Middleware(CORSMiddleware, allow_origins=["https://example.org"], allow_private_network=True)]
+    )
+    response = test_client_factory(app).options("/", headers=headers)
+    assert response.status_code == 200
+    assert response.headers["access-control-allow-private-network"] == "true"
+
+    app = Starlette(middleware=[Middleware(CORSMiddleware, allow_origins=["https://example.org"])])
+    response = test_client_factory(app).options("/", headers=headers)
+    assert response.status_code == 400
+    assert "access-control-allow-private-network" not in response.headers
+
