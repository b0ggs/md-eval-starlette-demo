@@ -542,6 +542,32 @@ async def test_streaming_response_stops_if_receiving_http_disconnect() -> None:
     assert not cancel_scope.cancel_called, "Content streaming should stop itself."
 
 
+@pytest.mark.anyio
+@pytest.mark.parametrize("spec_version", ["2.4", "3.0"])
+async def test_streaming_response_stops_on_send_disconnect(spec_version: str) -> None:
+    streamed = 0
+
+    async def receive() -> Message:
+        raise AssertionError("receive should not be called")
+
+    async def send(message: Message) -> None:
+        if message["type"] == "http.response.body":
+            raise OSError
+
+    async def stream_indefinitely() -> AsyncIterator[bytes]:
+        nonlocal streamed
+        while True:
+            streamed += 1
+            yield b"chunk"
+
+    response = StreamingResponse(content=stream_indefinitely())
+
+    with pytest.raises(ClientDisconnect):
+        await response({"asgi": {"spec_version": spec_version}}, receive, send)
+
+    assert streamed == 1
+
