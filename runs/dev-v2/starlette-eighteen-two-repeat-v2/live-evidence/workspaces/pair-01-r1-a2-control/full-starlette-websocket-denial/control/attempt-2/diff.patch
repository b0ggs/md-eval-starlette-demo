diff --git a/tests/test_responses.py b/tests/test_responses.py
index 6216694..4d57b48 100644
--- a/tests/test_responses.py
+++ b/tests/test_responses.py
@@ -126,6 +126,43 @@ def test_streaming_response(test_client_factory: TestClientFactory) -> None:
     assert filled_by_bg_task == "6, 7, 8, 9"
 
 
+@pytest.mark.anyio
+async def test_streaming_response_as_websocket_denial() -> None:
+    messages: list[Message] = []
+    background_call_count = 0
+
+    async def stream() -> AsyncIterator[str]:
+        yield "streamed"
+        yield " body"
+
+    async def receive() -> Message:
+        raise AssertionError("WebSocket denial responses must not listen for HTTP disconnects")
+
+    async def send(message: Message) -> None:
+        messages.append(message)
+
+    async def background() -> None:
+        nonlocal background_call_count
+        background_call_count += 1
+
+    response = StreamingResponse(
+        stream(),
+        status_code=403,
+        background=BackgroundTask(background),
+    )
+    await response({"type": "websocket", "headers": []}, receive, send)
+
+    assert [message["type"] for message in messages] == [
+        "websocket.http.response.start",
+        "websocket.http.response.body",
+        "websocket.http.response.body",
+        "websocket.http.response.body",
+    ]
+    assert b"".join(message.get("body", b"") for message in messages) == b"streamed body"
+    assert messages[-1] == {"type": "websocket.http.response.body", "body": b"", "more_body": False}
+    assert background_call_count == 1
+
+
 def test_streaming_response_custom_iterator(
     test_client_factory: TestClientFactory,
 ) -> None:
@@ -249,6 +286,53 @@ def test_file_response(tmp_path: Path, test_client_factory: TestClientFactory) -
     assert filled_by_bg_task == "6, 7, 8, 9"
 
 
+@pytest.mark.anyio
+async def test_file_response_as_websocket_denial(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    path = tmp_path / "denied.txt"
+    path.write_bytes(b"file body")
+    messages: list[Message] = []
+
+    class AsyncFile:
+        def __init__(self, path: Path) -> None:
+            self.file = path.open("rb")
+
+        async def __aenter__(self) -> AsyncFile:
+            return self
+
+        async def __aexit__(self, *args: object) -> None:
+            self.file.close()
+
+        async def read(self, size: int) -> bytes:
+            return self.file.read(size)
+
+    async def open_file(path: str | Path, mode: str) -> AsyncFile:
+        assert mode == "rb"
+        return AsyncFile(Path(path))
+
+    monkeypatch.setattr(anyio, "open_file", open_file)
+
+    async def receive() -> Message:  # type: ignore[empty-body]
+        ...  # pragma: no cover
+
+    async def send(message: Message) -> None:
+        messages.append(message)
+
+    response = FileResponse(path, status_code=404, stat_result=path.stat())
+    await response(
+        {
+            "type": "websocket",
+            "headers": [],
+            "extensions": {"websocket.http.response": {}, "http.response.pathsend": {}},
+        },
+        receive,
+        send,
+    )
+
+    assert messages[0]["type"] == "websocket.http.response.start"
+    assert messages[0]["status"] == 404
+    assert messages[1] == {"type": "websocket.http.response.body", "body": b"file body", "more_body": False}
+
+
