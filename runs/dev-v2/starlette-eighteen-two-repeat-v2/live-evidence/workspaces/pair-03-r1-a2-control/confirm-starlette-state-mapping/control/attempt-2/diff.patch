-from collections.abc import Iterator
+from collections import UserDict
+from collections.abc import Iterator, MutableMapping
 from typing import Any
 
 import anyio
@@ -303,6 +304,27 @@ def test_request_state_object() -> None:
         s.new
 
 
+def test_request_state_mapping() -> None:
+    values: UserDict[str, Any] = UserDict({"old": "foo", "items": []})
+    scope: Scope = {"type": "http", "state": values}
+    state = Request(scope).state
+
+    assert isinstance(state, MutableMapping)
+    assert state["old"] == "foo"
+
+    state["new"] = "value"
+    assert values["new"] == "value"
+
+    values["items"].append(1)
+    assert state["items"] == [1]
+    assert state.items == [1]
+    assert state == values
+
+    del state["old"]
+    assert list(state) == ["items", "new"]
+    assert len(state) == 2
+
+
 def test_request_state(test_client_factory: TestClientFactory) -> None:
