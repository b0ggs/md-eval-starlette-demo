+@pytest.mark.parametrize("body_raises", [False, True])
+@pytest.mark.anyio
+async def test_request_form_context_manager_closes_upload_files(body_raises: bool) -> None:
+    uploads = [
+        UploadFile(BytesIO(b"one"), filename="one.txt"),
+        UploadFile(BytesIO(b"two"), filename="two.txt"),
+    ]
+    request = Request({"type": "http"})
+    request._form = FormData([("files", upload) for upload in uploads])
+
+    try:
+        async with request.form() as form:
+            assert form.getlist("files") == uploads
+            assert all(not upload.file.closed for upload in uploads)
+            if body_raises:
+                raise RuntimeError("context body failed")
+    except RuntimeError:
+        assert body_raises
+
+    assert all(upload.file.closed for upload in uploads)
+
