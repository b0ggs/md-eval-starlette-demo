+def test_request_state_mapping() -> None:
+    backing: UserDict[str, Any] = UserDict({"old": "foo"})
+    scope: Scope = {"type": "http", "state": backing}
+    state = Request(scope).state
+
+    assert isinstance(state, MutableMapping)
+    assert state["old"] == "foo"
+
+    state["new"] = "value"
+    assert state.new == "value"
+    assert backing["new"] == "value"
+    assert list(state) == ["old", "new"]
+    assert len(state) == 2
+
+    state.attribute = "access"
+    assert state["attribute"] == "access"
+
+    del state["old"]
+    assert "old" not in backing
+
+
